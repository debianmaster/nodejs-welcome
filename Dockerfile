# Use the official Node.js image as a base echo FROM node:14 echo  echo # Set the working directory echo WORKDIR /usr/src/app echo  echo # Copy package.json and package-lock.json echo COPY package*.json ./  echo  echo # Install dependencies echo RUN npm install echo  echo # Copy the rest of the application code echo COPY . . echo  echo # Expose the application port echo EXPOSE 8080 echo  echo # Command to run the application echo CMD [ "npm", "start" ]
